# Copy to .env and replace every placeholder before starting the stack.
# Never commit .env or real credentials.
DB_PASSWORD=replace-with-a-unique-database-password
PEERVAULT_JWT_SECRET=replace-with-at-least-32-random-bytes
COREISSUER_PEPPER=replace-with-a-separate-long-random-secret
PEERVAULT_ADMIN_EMAIL=
PEERVAULT_ADMIN_PASSWORD=

# Optional. Needed for live Stripe PaymentIntent and webhook operations.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
